<% include header %>

<h2>식단 등록</h2>

<form method="post" role="form">
  <div class="form-group">
    <label for="title">제목</label>
    <input type="text" class="form-control" id="title" name="title" placeholder="식단 제목" required>
  </div>
  <div class="form-group">
    <label for="body">식단 내용</label>
    <textarea class="form-control" id="body" name="body" placeholder="원하는 식단을 입력해주세요" rows="3" required></textarea>
  </div>
  <div class="form-group">
    <input type="submit" value="Post entry" class="btn btn-primary">
  </div>
</form>

<% include footer %>
